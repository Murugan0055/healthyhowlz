# ==============================================================================
# HealthyHowlz Multi-Tenant Fitness OS — Production Environment Configuration
# Copy this file to .env or backend/.env and update your real values
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# Security Secrets (Generate a strong random string: e.g. `openssl rand -hex 32`)
JWT_SECRET=healthyhowlz_super_secret_jwt_key_2026_replace_with_random_hex
OFFICER_MASTER_PIN=1234

# SQLite Database Location
DATABASE_PATH=backend/elite_gym.db

# Domain & Web Address
PUBLIC_APP_URL=https://app.healthyhowlz.com
CORS_ORIGIN=https://app.healthyhowlz.com

# Kiosk & Platform Settings
PLATFORM_NAME="HealthyHowlz Multi-Tenant Fitness OS"
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹
DEFAULT_GST_RATE=18.0

